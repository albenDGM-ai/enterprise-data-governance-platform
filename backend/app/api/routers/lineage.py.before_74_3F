    snapshot_date_to: str | None = None,
    include_inactive: bool = False,
    service: LineageSnapshotService = Depends(get_lineage_snapshot_service),
) -> list[LineageSnapshotResponse]:
    from datetime import datetime

    date_from = (
        datetime.fromisoformat(snapshot_date_from)
        if snapshot_date_from
        else None
    )
    date_to = (
        datetime.fromisoformat(snapshot_date_to)
        if snapshot_date_to
        else None
    )

    return service.list(
        lineage_flow_id=lineage_flow_id,
        status=status,
        snapshot_date_from=date_from,
        snapshot_date_to=date_to,
        include_inactive=include_inactive,
    )


@router.put(
    "/snapshots/{lineage_snapshot_id}",
    response_model=LineageSnapshotResponse,
)
def replace_lineage_snapshot(
    lineage_snapshot_id: UUID,
    payload: LineageSnapshotReplace,
    x_user: str = Header(..., alias="X-User"),
    service: LineageSnapshotService = Depends(get_lineage_snapshot_service),
) -> LineageSnapshotResponse:
    entity = service.get(lineage_snapshot_id)

    if entity is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Lineage Snapshot not found.",
        )

    try:
        entity = service.update(
            entity,
            modified_by=x_user,
            snapshot_name=payload.snapshot_name,
            snapshot_date=payload.snapshot_date,
            status=payload.status,
        )
        service.session.commit()
        service.session.refresh(entity)
        return entity
    except ValueError as exc:
        service.session.rollback()
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail=str(exc),
        ) from exc
    except Exception:
        service.session.rollback()
        raise


