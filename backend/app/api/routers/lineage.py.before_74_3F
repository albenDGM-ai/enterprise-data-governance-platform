def get_mapping_service(
    db: Session = Depends(get_db),
) -> LineageMappingService:
    return LineageMappingService(db)


@router.post(
    "/mappings",
    response_model=LineageMappingResponse,
    status_code=status.HTTP_201_CREATED,
)
def create_mapping(
    payload: LineageMappingCreate,
    x_user: str = Header(..., alias="X-User"),
    service: LineageMappingService = Depends(get_mapping_service),
) -> LineageMappingResponse:
    try:
        entity = service.create(
            lineage_flow_id=payload.lineage_flow_id,
            lineage_transformation_id=payload.lineage_transformation_id,
            source_attribute=payload.source_attribute,
