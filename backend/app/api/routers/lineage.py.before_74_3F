@router.delete(
    "/snapshots/{lineage_snapshot_id}",
    response_model=LineageSnapshotResponse,
)
def delete_lineage_snapshot(
    lineage_snapshot_id: UUID,
    x_user: str = Header(..., alias="X-User"),
    service: LineageSnapshotService = Depends(get_lineage_snapshot_service),
) -> LineageSnapshotResponse:
    entity = service.get(lineage_snapshot_id)

    if entity is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Lineage Snapshot not found.",
        )

    try:
        entity = service.archive(
            entity,
            modified_by=x_user,
        )
        service.session.commit()
        service.session.refresh(entity)
        return entity
    except Exception:
        service.session.rollback()
        raise


def get_lineage_discovery_service(
    db: Session = Depends(get_db),
) -> LineageDiscoveryService:
    return LineageDiscoveryService(db)


@router.get(
    "/discovery",
    response_model=list[LineageDiscoveryResponse],
)
def discover_lineage(
    lineage_source_id: UUID | None = None,
    lineage_process_id: UUID | None = None,
    lineage_flow_id: UUID | None = None,
    include_inactive: bool = False,
    service: LineageDiscoveryService = Depends(
        get_lineage_discovery_service
    ),
) -> list[LineageDiscoveryResponse]:
    return service.discover(
        lineage_source_id=lineage_source_id,
        lineage_process_id=lineage_process_id,
        lineage_flow_id=lineage_flow_id,
        include_inactive=include_inactive,
    )
