router = APIRouter(
    prefix="/lineage",
    tags=["Data Lineage"],
)


@router.get("/_health")
def lineage_api_health():
    return {
        "status": "UP",
        "service": "data-lineage-api",
    }




def get_flow_service(db: Session = Depends(get_db)) -> LineageFlowService:
    return LineageFlowService(db)


@router.post(
    "/flows",
    response_model=LineageFlowResponse,
    status_code=status.HTTP_201_CREATED,
)
def create_flow(
    payload: LineageFlowCreate,
    x_user: str = Header(..., alias="X-User"),
    service: LineageFlowService = Depends(get_flow_service),
) -> LineageFlowResponse:
    try:
        entity = service.create(
            lineage_source_id=payload.lineage_source_id,
            lineage_process_id=payload.lineage_process_id,
            flow_name=payload.flow_name,
            flow_type=payload.flow_type,
            direction=payload.direction,
            frequency=payload.frequency,
            owner=payload.owner,
            status=payload.status,
            created_by=x_user,
        )
        service.session.commit()
        service.session.refresh(entity)
        return entity
    except ValueError as exc:
        service.session.rollback()
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail=str(exc),
        ) from exc
    except Exception:
        service.session.rollback()
        raise


@router.get(
    "/flows/{lineage_flow_id}",
    response_model=LineageFlowResponse,
)
def get_flow(
    lineage_flow_id: UUID,
    include_inactive: bool = False,
    service: LineageFlowService = Depends(get_flow_service),
) -> LineageFlowResponse:
    entity = service.get(
        lineage_flow_id,
        include_inactive=include_inactive,
    )

    if entity is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Lineage Flow not found.",
        )

    return entity


@router.get(
    "/flows",
    response_model=list[LineageFlowResponse],
)
def list_flows(
    status: str | None = None,
    flow_type: str | None = None,
    direction: str | None = None,
    owner: str | None = None,
    lineage_source_id: UUID | None = None,
    lineage_process_id: UUID | None = None,
    include_inactive: bool = False,
    service: LineageFlowService = Depends(get_flow_service),
) -> list[LineageFlowResponse]:
    return service.list(
        status=status,
        flow_type=flow_type,
        direction=direction,
        owner=owner,
        lineage_source_id=lineage_source_id,
        lineage_process_id=lineage_process_id,
        include_inactive=include_inactive,
    )


@router.put(
    "/flows/{lineage_flow_id}",
    response_model=LineageFlowResponse,
)
def replace_flow(
    lineage_flow_id: UUID,
    payload: LineageFlowReplace,
    x_user: str = Header(..., alias="X-User"),
    service: LineageFlowService = Depends(get_flow_service),
) -> LineageFlowResponse:
    entity = service.get(lineage_flow_id)

    if entity is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Lineage Flow not found.",
        )

    try:
        entity = service.update(
            entity,
            modified_by=x_user,
            flow_name=payload.flow_name,
            lineage_source_id=payload.lineage_source_id,
            lineage_process_id=payload.lineage_process_id,
            flow_type=payload.flow_type,
            direction=payload.direction,
            frequency=payload.frequency,
            owner=payload.owner,
            status=payload.status,
        )
        service.session.commit()
        service.session.refresh(entity)
        return entity
    except ValueError as exc:
        service.session.rollback()
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail=str(exc),
        ) from exc
    except Exception:
        service.session.rollback()
        raise


