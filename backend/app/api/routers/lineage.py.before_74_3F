    service: ImpactAnalysisService = Depends(get_impact_analysis_service),
) -> ImpactAnalysisResponse:
    entity = service.get(impact_analysis_id)

    if entity is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Impact Analysis not found.",
        )

    return entity


@router.get(
    "/impact-analyses",
    response_model=list[ImpactAnalysisResponse],
)
def list_impact_analyses(
    lineage_mapping_id: UUID | None = None,
    impact_scope: str | None = None,
    status: str | None = None,
    requested_by: str | None = None,
    analysis_date_from: str | None = None,
    analysis_date_to: str | None = None,
    service: ImpactAnalysisService = Depends(get_impact_analysis_service),
) -> list[ImpactAnalysisResponse]:
    from datetime import datetime

    date_from = (
        datetime.fromisoformat(analysis_date_from)
        if analysis_date_from
        else None
    )
    date_to = (
        datetime.fromisoformat(analysis_date_to)
        if analysis_date_to
        else None
    )

    return service.list(
        lineage_mapping_id=lineage_mapping_id,
        impact_scope=impact_scope,
        status=status,
        requested_by=requested_by,
        analysis_date_from=date_from,
        analysis_date_to=date_to,
    )


@router.put(
    "/impact-analyses/{impact_analysis_id}",
    response_model=ImpactAnalysisResponse,
)
def replace_impact_analysis(
    impact_analysis_id: UUID,
    payload: ImpactAnalysisCreate,
    x_user: str = Header(..., alias="X-User"),
    service: ImpactAnalysisService = Depends(get_impact_analysis_service),
) -> ImpactAnalysisResponse:
    entity = service.get(impact_analysis_id)

    if entity is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Impact Analysis not found.",
        )

    try:
        entity.lineage_mapping_id = payload.lineage_mapping_id
        entity.analysis_number = payload.analysis_number
        entity.source_asset = payload.source_asset
        entity.impact_scope = payload.impact_scope
        entity.affected_objects = payload.affected_objects
        entity.analysis_date = payload.analysis_date
        entity.requested_by = payload.requested_by
        entity.status = payload.status

        entity = service.update(
            entity,
            modified_by=x_user,
        )
        service.session.commit()
        service.session.refresh(entity)
        return entity
    except ValueError as exc:
        service.session.rollback()
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail=str(exc),
        ) from exc
    except Exception:
        service.session.rollback()
        raise


